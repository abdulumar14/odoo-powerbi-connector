<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
<!--
    noupdate="1" — these records are created on first install only.
    User edits are preserved on module upgrade.
-->

    <record id="dataset_purchase_orders" model="powerbi.dataset">
        <field name="name">Purchase Orders</field>
        <field name="endpoint_key">purchase_orders</field>
        <field name="odoo_model">purchase.order</field>
        <field name="sync_mode">live</field>
        <field name="date_field">date_order</field>
        <field name="fields_to_export">id, name, partner_id, date_order, date_approve, amount_untaxed, amount_tax, amount_total, currency_id, state, user_id, company_id, invoice_status</field>
        <field name="domain_filter">[["state", "in", ["purchase", "done"]]]</field>
    </record>

    <record id="dataset_purchase_order_lines" model="powerbi.dataset">
        <field name="name">Purchase Order Lines</field>
        <field name="endpoint_key">purchase_order_lines</field>
        <field name="odoo_model">purchase.order.line</field>
        <field name="sync_mode">scheduled</field>
        <field name="date_field">date_planned</field>
        <field name="fields_to_export">id, order_id, product_id, name, product_qty, qty_received, qty_invoiced, price_unit, price_subtotal, price_total, date_planned, state</field>
        <field name="domain_filter">[["order_id.state", "in", ["purchase", "done"]]]</field>
    </record>

    <record id="dataset_vendor_bills" model="powerbi.dataset">
        <field name="name">Vendor Bills</field>
        <field name="endpoint_key">vendor_bills</field>
        <field name="odoo_model">account.move</field>
        <field name="sync_mode">live</field>
        <field name="date_field">invoice_date</field>
        <field name="fields_to_export">id, name, partner_id, invoice_date, invoice_date_due, amount_untaxed, amount_tax, amount_total, amount_residual, move_type, state, currency_id, invoice_user_id, payment_state, company_id</field>
        <field name="domain_filter">[["move_type", "=", "in_invoice"], ["state", "=", "posted"]]</field>
    </record>

    <record id="dataset_customer_invoices" model="powerbi.dataset">
        <field name="name">Customer Invoices</field>
        <field name="endpoint_key">customer_invoices</field>
        <field name="odoo_model">account.move</field>
        <field name="sync_mode">live</field>
        <field name="date_field">invoice_date</field>
        <field name="fields_to_export">id, name, partner_id, invoice_date, invoice_date_due, amount_untaxed, amount_tax, amount_total, amount_residual, move_type, state, currency_id, invoice_user_id, payment_state, company_id</field>
        <field name="domain_filter">[["move_type", "=", "out_invoice"], ["state", "=", "posted"]]</field>
    </record>

    <record id="dataset_stock_moves" model="powerbi.dataset">
        <field name="name">Inventory Movements</field>
        <field name="endpoint_key">stock_moves</field>
        <field name="odoo_model">stock.move</field>
        <field name="sync_mode">scheduled</field>
        <field name="date_field">date</field>
        <field name="fields_to_export">id, name, product_id, product_uom_qty, quantity, location_id, location_dest_id, date, picking_id, state, company_id</field>
        <field name="domain_filter">[["state", "=", "done"]]</field>
    </record>

    <record id="dataset_projects" model="powerbi.dataset">
        <field name="name">Projects</field>
        <field name="endpoint_key">projects</field>
        <field name="odoo_model">project.project</field>
        <field name="sync_mode">live</field>
        <field name="date_field">date_start</field>
        <field name="fields_to_export">id, name, partner_id, user_id, date_start, date, analytic_account_id, company_id</field>
        <field name="domain_filter">[["active", "=", true]]</field>
    </record>

    <record id="dataset_analytic_lines" model="powerbi.dataset">
        <field name="name">Analytic Lines (Cost)</field>
        <field name="endpoint_key">analytic_lines</field>
        <field name="odoo_model">account.analytic.line</field>
        <field name="sync_mode">scheduled</field>
        <field name="date_field">date</field>
        <field name="fields_to_export">id, name, date, amount, unit_amount, product_id, partner_id, account_id, company_id, move_line_id</field>
        <field name="domain_filter">[]</field>
    </record>

    <record id="dataset_vendors" model="powerbi.dataset">
        <field name="name">Vendors</field>
        <field name="endpoint_key">vendors</field>
        <field name="odoo_model">res.partner</field>
        <field name="sync_mode">scheduled</field>
        <field name="date_field">create_date</field>
        <field name="fields_to_export">id, name, country_id, city, email, phone, supplier_rank, customer_rank, company_type, active</field>
        <field name="domain_filter">[["supplier_rank", ">", 0]]</field>
    </record>

</odoo>
